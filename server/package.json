{
  "name": "taskflow-server",
  "version": "1.0.0",
  "description": "Express + MongoDB + Socket.io backend for TaskFlow project management tool",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",

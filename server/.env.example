# Server port
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/taskflow
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow
# Leave empty to auto-start an in-memory MongoDB (dev only, data resets on restart).
MONGODB_URI=

# Secret used to sign JWT tokens.
# REQUIRED for any non-local deployment: the server refuses to start in
# production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed origin for CORS (the React dev server)
CLIENT_URL=http://localhost:5173

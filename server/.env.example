# Server port
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/taskflow
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow
# Leave empty to auto-start an in-memory MongoDB (local development only, data
# resets on restart). The demo accounts are seeded into it automatically.
# Required when NODE_ENV=production.
MONGODB_URI=

# Secret used to sign JWT tokens. REQUIRED: the server will not start without it.
# The placeholder below is accepted for local development only; with
# NODE_ENV=production the server refuses to start unless this is a random
# string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Allowed origin for CORS (the React dev server)
CLIENT_URL=http://localhost:5173

# Seed the demo accounts on startup when the database has none.
# Defaults to true for the in-memory database and false otherwise.
# SEED_ON_START=false
